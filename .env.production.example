# Plantilla para el Droplet. No contiene secretos reales.
# En el servidor: cp .env.production.example .env.production && chmod 600 .env.production
# No copie el .env de desarrollo. Los valores van sin comillas, sin espacios y sin $.
# docker-compose.prod.yml fija SEED_DEMO_USERS=false y COOKIE_SECURE=true.

POSTGRES_USER=sigot
POSTGRES_PASSWORD=cambie-esta-clave
POSTGRES_DB=sigot

JWT_ACCESS_SECRET=cambie-este-secreto-por-uno-aleatorio-de-64-caracteres
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# https:// más SIGOT_DOMAIN, sin barra y sin puerto.
APP_URL=https://sigot.ejemplo.com
SIGOT_DOMAIN=sigot.ejemplo.com
LETSENCRYPT_EMAIL=admin@ejemplo.com
# 1 emite contra el entorno de pruebas. 0 emite el certificado que el navegador acepta.
LETSENCRYPT_STAGING=1

MAX_UPLOAD_MB=8
LOG_LEVEL=info

SEED_DEMO_USERS=false

# Solo se usa si todavía no existe ningún usuario. El primer acceso obliga a cambiarla.
ADMIN_INICIAL_CORREO=admin@ejemplo.com
ADMIN_INICIAL_PASSWORD=Cambie-Esta-Clave1
ADMIN_INICIAL_NOMBRE=Administrador
ADMIN_INICIAL_APELLIDO=Inicial

# Déjelas comentadas para construir sigot-backend:local y sigot-frontend:local en el Droplet.
# Si publica con el workflow, use DOCKERHUB_USERNAME y el SHA del commit:
# SIGOT_IMAGE_BACKEND=USUARIO/sigot-backend:SHA
# SIGOT_IMAGE_FRONTEND=USUARIO/sigot-frontend:SHA

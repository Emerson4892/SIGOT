# Copie este archivo con: node scripts/init-env.mjs
# Ese comando genera secretos locales y no los escribe en git.
# No coloque contraseñas reales en este ejemplo.

POSTGRES_USER=sigot
POSTGRES_PASSWORD=cambie-esta-clave
POSTGRES_DB=sigot

# Usado por Prisma cuando el backend corre en el host (puerto publicado de PostgreSQL).
DATABASE_URL=postgresql://sigot:cambie-esta-clave@localhost:5432/sigot
TEST_DATABASE_URL=postgresql://sigot:cambie-esta-clave@localhost:5432/sigot_test

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=false

# Mínimo 32 caracteres. Genere uno aleatorio; no reutilice este texto.
JWT_ACCESS_SECRET=cambie-este-secreto-por-uno-aleatorio-de-64-caracteres
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
COOKIE_SECURE=false

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# Inicialización local de usuarios de demostración.
# Las contraseñas viven solo en .env, nunca en el repositorio.
SEED_DEMO_USERS=true
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_PASSWORD=
SEED_SUPERVISOR_PASSWORD=
SEED_TECHNICIAN_PASSWORD=
SEED_WAREHOUSE_PASSWORD=
